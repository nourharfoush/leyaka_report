# انسخ هذا الملف إلى .env.local واملأ القيم (لا ترفعه على GitHub)
# MongoDB Atlas: Database Access + Network Access (0.0.0.0/0 أو IP فيرسل) ثم Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/leyaka?retryWrites=true&w=majority
MONGODB_DB=leyaka
# نص عشوائي طويل لتوقيع الجلسات
SESSION_SECRET=change-me-to-a-long-random-string
# للتطوير المحلي فقط (vercel dev)
# PORT=3000
